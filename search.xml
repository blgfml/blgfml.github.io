        <content type="html"><![CDATA[<h1 id="DNS-setting"><a href="#DNS-setting" class="headerlink" title="DNS setting"></a><a href="https://dev.to/drjoanneskiles/how-to-connect-a-squarespace-domain-to-a-website-hosted-on-github-pages-47i8">DNS setting</a></h1><h1 id="Publish-Web"><a href="#Publish-Web" class="headerlink" title="Publish Web"></a>Publish Web</h1><figure class="highlight bash"><table><tbody><tr><td class="gutter"><pre><span class="line">1</span><br><span class="line">2</span><br><span class="line">3</span><br><span class="line">4</span><br><span class="line">5</span><br><span class="line">6</span><br><span class="line">7</span><br><span class="line">8</span><br><span class="line">9</span><br><span class="line">10</span><br></pre></td><td class="code"><pre><span class="line">npm install hexo-deployer-git --save</span><br><span class="line"><span class="comment"># Before deploy new post / config change</span></span><br><span class="line">hexo server</span><br><span class="line"><span class="comment"># localhost:4000</span></span><br><span class="line"><span class="comment"># d = deploy (publish)</span></span><br><span class="line">hexo clean &amp;&amp; hexo g &amp;&amp; hexo d</span><br><span class="line"><span class="comment"># s = server (local)</span></span><br><span class="line">hexo clean &amp;&amp; hexo g &amp;&amp; hexo s</span><br><span class="line"></span><br><span class="line"></span><br></pre></td></tr></tbody></table></figure><h1 id="Password"><a href="#Password" class="headerlink" title="Password"></a>Password</h1><p>use <a href="https://emn178.github.io/online-tools/sha256.html">sha256</a></p>]]></content>
      
      
      
